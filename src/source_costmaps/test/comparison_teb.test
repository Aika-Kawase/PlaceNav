<launch>
  <!-- Optional runtime check: requires the existing diagnostic-enabled TEB. -->
  <arg name="fusion_mode" default="layers"/>
  <arg name="output_dir"/>
  <param name="use_sim_time" value="true"/>
  <include file="$(find source_costmaps)/launch/pipeline.launch">
    <arg name="fusion_mode" value="$(arg fusion_mode)"/>
    <arg name="comparison_profile" value="matched"/>
  </include>
  <rosparam command="load" file="$(find placenav_teb_bridge)/config/bridge.yaml" ns="placenav_teb_bridge"/>
  <include file="$(find source_costmaps)/launch/load_costmap.launch">
    <arg name="target_ns" value="/placenav_teb_bridge"/>
    <arg name="fusion_mode" value="$(arg fusion_mode)"/>
    <arg name="comparison_profile" value="matched"/>
  </include>
  <node pkg="placenav_teb_bridge" type="placenav_teb_bridge_node" name="placenav_teb_bridge" required="true" output="screen">
    <param name="cmd_vel_topic" value="/fusion_validation/cmd_vel"/>
    <param name="diagnostics_enabled" value="true"/>
  </node>
  <test pkg="source_costmaps" type="test_dual_layer.py" test-name="fusion_teb_runtime" time-limit="90">
    <param name="output_dir" value="$(arg output_dir)"/>
  </test>
</launch>
