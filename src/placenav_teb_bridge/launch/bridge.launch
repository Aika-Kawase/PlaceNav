<launch>
  <arg name="config" default="$(find placenav_teb_bridge)/config/bridge.yaml"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="global_frame" default="odom"/>
  <arg name="robot_base_frame" default="base_link"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="stvl_topic" default="/c2/depth/points"/>

  <arg name="reference_mode" default="state_machine"/>
  <arg name="path_timeout" default="0.0"/>
  <arg name="shrink_horizon_backup" default="true"/>

  <node pkg="placenav_teb_bridge"
        type="placenav_teb_bridge_node"
        name="placenav_teb_bridge"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="reference_mode" value="$(arg reference_mode)"/>
    <param name="path_timeout" value="$(arg path_timeout)"/>
    <param name="TebLocalPlannerROS/shrink_horizon_backup" value="$(arg shrink_horizon_backup)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="local_costmap/global_frame" value="$(arg global_frame)"/>
    <param name="local_costmap/robot_base_frame" value="$(arg robot_base_frame)"/>
    <param name="TebLocalPlannerROS/odom_topic" value="$(arg odom_topic)"/>
    <param name="local_costmap/stvl/depth_cloud/topic" value="$(arg stvl_topic)"/>
  </node>
</launch>
